OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CRM_SERVICE_URL=http://localhost:8001
BILLING_SERVICE_URL=http://localhost:8002
PROVISIONING_SERVICE_URL=http://localhost:8003
INVENTORY_SERVICE_URL=http://localhost:8004
CHROMA_PATH=./chroma_kb_data
SPECIALIST_MAX_ITERATIONS=3
SUPERVISOR_CHECKPOINT_DB=agent_checkpoints.db   # Phase 4 -- optional, defaults to this if unset
API_KEY=
MOCK_FAILURE_RATE=0.1
MOCK_LATENCY_MIN_MS=200
MOCK_LATENCY_MAX_MS=1500

# Phase 8 [EXTENDED] -- local Neo4j (see docker-compose.yml's neo4j service
# for why this is local, not Aura). NEO4J_PASSWORD also drives the
# container's own auth via docker-compose's ${NEO4J_PASSWORD} substitution.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
