# Virtual environment
env/

# Python
__pycache__/
*.pyc
*.egg-info/

# Secrets -- .env.example is the template and IS committed, .env is not
.env

# SQLite databases -- generated by each service's own seed() on startup,
# never source data to commit (04-BUILD-PLAN.md Phase 1)
*.db

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Chroma local vector store (Phase 8+ / Days 13-14 pattern)
chroma_kb_data/

# Structured log output (Phase 5, agent/observability.py) -- generated at
# runtime, never source data to commit
*.jsonl
